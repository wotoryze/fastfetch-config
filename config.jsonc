{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "small", // 
    "height": 10,    // Depending on your distro
    "width": 26,     // you may need
    "padding": {     // to change 
      "top": 1,      // these properties
      "left": 3      // 
    }
  },
  "modules": [
    {
      "type": "title",
      "format": "\u001b[90m┌──\u001b[93;1m{user-name}\u001b[97;22m@\u001b[93;1m{host-name}\u001b[90;22m───────────────────  ─────   ───    ─"
    },
    {
      "type": "kernel",
      "key": "\u001b[90m│\u001b[94m  "
    },
    {
      "type": "shell",
      "key": "\u001b[90m│\u001b[94m 󰞷 "
    },
    {
      "type": "wm",
      "key": "\u001b[90m│\u001b[94m 󱂬 "
    },
    {
      "type": "lm",
      "key": "\u001b[90m│\u001b[94m 󰍁 "
    },
    {
      "type": "terminal",
      "key": "\u001b[90m│\u001b[94m 󰆍 "
    },
    {
      "type": "packages",
      "key": "\u001b[90m│\u001b[94m 󰏗 "
    },
    {
      "type": "cpu",
      "key": "\u001b[90m│\u001b[94m 󰻠 ",
      "format": "{name}"
    },
    {
      "type": "gpu",
      "key": "\u001b[90m│\u001b[94m 󰍹 ",
      "hideType": "integrated",
      "format": "{vendor} {name}"
    },
    {
      "type": "memory",
      "key": "\u001b[90m│\u001b[94m 󰑭 "
    },
    {
      "type": "disk",
      "key": "\u001b[90m│\u001b[94m 󰋊 "
    },
    {
      "type": "command",
      "key": "\u001b[90m│\u001b[94m  ",
      "text": "birth=$(stat -c %W /); now=$(date +%s); time_diff=$((now - birth)); days=$((time_diff / 86400)); echo $days days"
    },
    {
      "type": "custom",
      "format": "\u001b[90m└──\u001b[91m●\u001b[90m─\u001b[92m●\u001b[90m─\u001b[93m●\u001b[90m─\u001b[94m●\u001b[90m─\u001b[95m●\u001b[90m─\u001b[96m●\u001b[90m─\u001b[97m●\u001b[90m─●\u001b[90m──────────────  ─────   ───    ─"
    }
  ]
}
